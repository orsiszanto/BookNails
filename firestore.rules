rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId));
    }

    function isOwnUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc(request.auth.uid).data.role == 'admin';
    }

    match /users/{userId} {
      allow read: if isOwnUser(userId) || isAdmin();
      allow create: if isOwnUser(userId)
        && request.resource.data.role == 'user';
      allow update: if isAdmin()
        || (isOwnUser(userId)
        && request.resource.data.role == resource.data.role;
      allow delete: if isOwnUser(userId) || isAdmin();
    }

    match /appointments/{appointmentId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /nailArtistProfiles/{profileId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}


